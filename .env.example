# ==============================================================================
# PANaHON + PH Solar Forecast Bridge Configuration (.env.example)
# ==============================================================================

# Philippine Location Coordinates (Default: Metro Manila - 14.5995, 120.9842)
PH_LATITUDE=14.5995
PH_LONGITUDE=120.9842
PH_LOCATION_NAME=Metro Manila

# Solar Array Specifications for PV Output & Battery Planning
SOLAR_ARRAY_KWP=5.0
SOLAR_PANEL_TILT_DEG=14.0
SOLAR_PANEL_AZIMUTH_DEG=0.0
SOLAR_SYSTEM_EFFICIENCY=0.82
SOLAR_TEMP_COEFF_PCT_PER_C=-0.35

# Optional: Authorized DOST-PAGASA PANaHON Mobile API Credentials
# Base URL: https://api.mobile.panahon.gov.ph/api/v1
# Leave blank to use the built-in ECMWF IFS + Solar Irradiance Engine automatically
PANAHON_BASE_URL=https://api.mobile.panahon.gov.ph/api/v1
PANAHON_DEVICE_ID=
PANAHON_ACCESS_TOKEN=
PANAHON_AWS_SITE_ID=

# Local Bridge Server Settings
PANAHON_SERVER_HOST=0.0.0.0
PANAHON_SERVER_PORT=8089
PANAHON_ADMIN_PASSWORD=ChangeMeSolarAdmin2026!
